# Copy this file to ".env" (exactly that name, no .txt) and fill in your keys.
# Never upload .env to GitHub or paste keys into chat. On Render, set these as
# Environment Variables instead.

# ---- Data provider ----
# "sample" (demo replay, no key needed) or "sportsdataio"
DATA_PROVIDER=sample
# Your SportsDataIO NFL API key (needed when DATA_PROVIDER=sportsdataio)
SPORTSDATAIO_API_KEY=
# REG, PRE or POST
SPORTSDATAIO_SEASON_TYPE=REG

# ---- Odds ----
# "sportsdataio" (default): use the betting line included with SportsDataIO scores.
# "theoddsapi": use the-odds-api.com (needs ODDS_API_KEY from that service).
ODDS_PROVIDER=sportsdataio
ODDS_API_KEY=
# Minutes between odds refreshes. Each refresh costs (markets x regions) credits.
ODDS_CACHE_MINUTES=180
ODDS_MARKETS=h2h,spreads
ODDS_REGIONS=us
# Leave empty for the consensus of all books, or e.g. draftkings
ODDS_BOOKMAKER=
# Stop calling when fewer credits than this remain
ODDS_MIN_REMAINING=25

PORT=8787
