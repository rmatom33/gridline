{
  "name": "gridline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gridline - mobile-first NFL live scores, game center, schedule and standings.",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:sample": "vite --mode sample",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode sample --outDir dist-preview",
    "start": "tsx server/index.ts",
    "check:sdio": "tsx server/check-sdio.ts",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "6.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
